{{- if eq .chezmoi.os "linux" -}}
{{- /* Map this distribution to a package family: its own id first, then each idLike parent in order. */ -}}
{{- $release := get .chezmoi "osRelease" | default dict -}}
{{- $ids := splitList " " (printf "%s %s" (get $release "id" | default "") (get $release "idLike" | default "")) -}}
{{- $families := dict "arch" "arch" "debian" "debian" "ubuntu" "debian" -}}
{{- $family := "" -}}
{{- range $ids -}}
{{-     if eq $family "" -}}
{{-         $family = get $families . -}}
{{-     end -}}
{{- end -}}
{{- /* Desktop machines get a GUI Emacs; each family names the package differently. */ -}}
{{- $emacs := "emacs-nox" -}}
{{- if ne $family "" -}}
{{-     if not (hasKey . "desktop") -}}
{{-         fail "Run chezmoi init to choose whether this is a desktop machine." -}}
{{-     end -}}
{{-     if and .desktop (eq $family "arch") -}}
{{-         $emacs = "emacs-wayland" -}}
{{-     else if and .desktop (eq $family "debian") -}}
{{-         $emacs = "emacs-gtk" -}}
{{-     end -}}
{{- end -}}
#!/bin/sh
set -eu

# Packages

{{ if eq $family "arch" -}}
sudo pacman -Syu --needed --noconfirm \
    bash \
    bash-completion \
    git \
    gnupg \
    tmux \
    ripgrep \
    direnv \
    bat \
    htop \
    {{ $emacs }} \
    openssh \
    base-devel \
    man-db \
    man-pages

{{ else if eq $family "debian" -}}
sudo apt-get update
sudo apt-get install -y \
    bash \
    bash-completion \
    git \
    gnupg \
    tmux \
    ripgrep \
    direnv \
    bat \
    htop \
    {{ $emacs }} \
    openssh-client \
    build-essential \
    man-db \
    manpages \
    locales

{{ else -}}
printf '%s\n' 'Unsupported Linux distribution: install packages manually.' >&2
exit 1
{{ end -}}

{{ if ne $family "" -}}
# UTF-8 locale

# Keep a working locale; otherwise ensure a UTF-8 fallback is available.
charmap=$(locale charmap 2>/dev/null) || charmap=
if [ "$charmap" != UTF-8 ]; then
    utf8_locale=C.UTF-8
    charmap=$(LC_ALL="$utf8_locale" locale charmap 2>/dev/null) || charmap=
    if [ "$charmap" != UTF-8 ]; then
        utf8_locale=en_US.UTF-8
        charmap=$(LC_ALL="$utf8_locale" locale charmap 2>/dev/null) || charmap=
        if [ "$charmap" != UTF-8 ]; then
            sudo localedef -i en_US -f UTF-8 en_US.UTF-8
        fi
    fi
    [ "$(LC_ALL="$utf8_locale" locale charmap)" = UTF-8 ]
fi

# Login shell

bash_path=/bin/bash
# shellcheck disable=SC2016
"$bash_path" --noprofile --norc -c 'test "${BASH_VERSINFO[0]}" -ge 5'
current_shell() {
    getent passwd "$(id -un)" | cut -d: -f7
}
shell_now=$(current_shell)
[ -n "$shell_now" ]
# /bin/bash and /usr/bin/bash may name the same executable.
if [ "$(readlink -f "$shell_now")" != "$(readlink -f "$bash_path")" ]; then
    if ! grep -Fxq "$bash_path" /etc/shells; then
        printf '%s\n' "$bash_path" | sudo tee -a /etc/shells >/dev/null
    fi
    chsh -s "$bash_path"
fi
[ "$(readlink -f "$(current_shell)")" = "$(readlink -f "$bash_path")" ]
{{ end -}}
{{ end -}}
