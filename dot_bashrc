#
# .bashrc for dcreemer
# should work on FreeBSD, Mac OS X, and Linux
#

if [[ -r "$HOME/.shell_env" ]]; then
    source "$HOME/.shell_env"
fi

# Fragments put environment setup before their own interactive guard.
for f in "$HOME"/.bash.d/*.sh; do
    [[ -f "$f" && -r "$f" ]] || continue
    source "$f"
done
unset f

# Prompt, terminal setup, and hooks belong only in interactive shells.
if [[ $- != *i* ]]; then
    return 0
fi

color_prompt=no
set_title=no
case "${TERM:-}" in
    xterm*|rxvt*)
        color_prompt=yes
        set_title=yes
        ;;
    eterm-color*|eat-truecolor)
        color_prompt=yes
        # emacs Term mode behaves much like xterm
        export TERM=xterm
        ;;
    screen*|tmux*|linux*)
        color_prompt=yes
        ;;
    *)
        ;;
esac

if [ "${color_prompt:-}" = yes ]; then
    PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='\u@\h:\w\$ '
fi
unset color_prompt

# when in a terminal window, change the title bar:
if [ "${set_title:-}" = "yes" ]; then
    PS1="\[\e]0;\u@\h: \w\a\]$PS1"
fi
unset set_title

# Select the color flags supported by the installed tools.
if command ls --color=auto -d . >/dev/null 2>&1; then
    alias ls='ls --color=auto -F'
elif command ls -G -d . >/dev/null 2>&1; then
    alias ls='ls -GF'
else
    alias ls='ls -F'
fi

if command grep --color=auto . <<<x >/dev/null 2>&1; then
    alias grep='grep --color=auto'
    alias fgrep='grep -F --color=auto'
    alias egrep='grep -E --color=auto'
fi

alias ec='emacsclient'
alias ff='emacsclient -n'

# history:
export HISTTIMEFORMAT="[%Y-%m-%d %T] "
export HISTSIZE=50000
export HISTFILESIZE=100000
export HISTCONTROL=ignoreboth
shopt -s histappend

# shell editor
export EDITOR="vi"

# GPG
if [[ -t 0 ]]; then
    GPG_TTY=$(tty)
    export GPG_TTY
fi
